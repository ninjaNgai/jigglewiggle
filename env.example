# ══════════════════════════════════════════════════════════════════════════════
# Jiggle Wiggle — Environment Variables
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────────────────────

# OpenAI — used for AI coaching (GPT-4o-mini) and TTS fallback
OPENAI_API_KEY=sk-...

# ── Highly recommended ────────────────────────────────────────────────────────

# ElevenLabs — higher quality TTS voices for coaching
# Get your key at https://elevenlabs.io
# If omitted, falls back to OpenAI TTS.
ELEVENLABS_API_KEY=

# ── Stripe subscription (required for premium features) ───────────────────────

# Stripe secret key (server-side only) — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe publishable key (safe for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — from https://dashboard.stripe.com/webhooks
# Used to verify webhook payloads (set up webhook at /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Your Stripe Price ID for the premium subscription plan
# Create a product + price at https://dashboard.stripe.com/products
STRIPE_PREMIUM_PRICE_ID=price_...

# ── Video storage (optional) ──────────────────────────────────────────────────

# Vercel Blob — for storing webcam session recordings
# Get from https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# ── AI video generation (optional) ───────────────────────────────────────────

# Replicate — for AI video generation and SAM2 background segmentation
# Get from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Grok / xAI (optional) ────────────────────────────────────────────────────

# Grok API key for Groq vision scoring (xAI)
XAI_API_KEY=

# ── Bright Data proxy (optional) ─────────────────────────────────────────────

# Required only if you need residential proxy support for yt-dlp
BRIGHTDATA_HOST=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# ── System dependencies (not env vars, but required) ─────────────────────────
# Install these on your machine / server:
#
#   yt-dlp:  pip install yt-dlp   OR   brew install yt-dlp
#   ffmpeg:  brew install ffmpeg  OR   apt-get install ffmpeg
#
# ══════════════════════════════════════════════════════════════════════════════
